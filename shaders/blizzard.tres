shader = SubResource("Shader_qvqk7")
shader_parameter/seed = 0.0
shader_parameter/base_color = Color(0.77254903, 0.85882354, 0.972549, 0.6666667)
shader_parameter/noise_dark_color = Color(0, 0, 0, 1)
