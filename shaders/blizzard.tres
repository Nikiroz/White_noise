shader_parameter/alpha_min = 0.3850000182875
shader_parameter/alpha_max = 0.6000000285
shader_parameter/speedBlizzard = 6.89
shader_parameter/direction = Vector2(3.9, -0.2)
shader_parameter/octaves = 4
shader_parameter/spread = 0.4450000211375
shader_parameter/size = 0.07000000262648
shader_parameter/snow_color = Color(1, 1, 1, 1)
shader_parameter/snow_transparency = 1.0
shader_parameter/speedSnow = 2.07600009861
shader_parameter/wind = 2.0
shader_parameter/num_of_layers = 10
